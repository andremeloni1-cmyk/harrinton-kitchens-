# dependencies
/node_modules

# next.js
/.next/
/out/
next-env.d.ts

# Generated per-build service-worker cache id (see scripts/gen-sw-version.mjs)
/public/sw-version.js

# production
/build

# env & secrets — ignore every .env variant (.env.production etc.), but keep
# the committed template.
.env*
!.env.example

# database (SQLite) — never commit data
*.db
*.db-journal
prisma/*.db
prisma/*.db-journal

# misc
*.log
.DS_Store

# Locally-downloaded Prisma engines (re-fetched on install)
/engines/

# TypeScript incremental build cache
*.tsbuildinfo
