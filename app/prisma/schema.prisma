// Harrington Kitchens data model.
// SQLite keeps deployment on a Hostinger VPS dead simple (single file, no server).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Singleton company/instance settings: branding, working hours, and the
// Google/Xero OAuth tokens once connected. Renamed from `Account`; @@map keeps
// the underlying table so no data migration is needed. User identity now lives
// in the `User` model — `email` here is retained as the company contact address.
model CompanySettings {
  id              String   @id @default(cuid())
  email           String   @unique
  name            String?
  // Google OAuth — null until the owner connects their Google account.
  googleAccessToken  String?
  googleRefreshToken String?
  googleTokenExpiry  DateTime?
  googleEmail        String?
  calendarId         String   @default("primary")
  driveFolderId      String?  // root Drive folder where job PDFs are filed
  signature          String?  // appended to client emails
  accentColor        String?  // brand accent hex (e.g. "#0d9488"); null = platform brass default
  depositPercent     Float    @default(30)   // deposit invoice % raised when a quote is accepted
  logo               String?  // base64 logo embedded in client email signatures
  logoMime           String?  // mime type of the logo (e.g. image/png)
  logoDark           String?  // base64 logo variant for dark backgrounds (falls back to logo)
  logoDarkMime       String?
  // Xero OAuth — null until connected. Refresh tokens are single-use rotating,
  // so the stored value is replaced on every refresh.
  xeroAccessToken       String?
  xeroRefreshToken      String?
  xeroTokenExpiry       DateTime?
  xeroTenantId          String?   // Xero organisation (tenant) id from /connections
  xeroOrgName           String?   // organisation display name for the Settings card
  xeroLastInvoiceSyncAt DateTime? // throttles the pull-sync on invoices page load
  // Which Xero bank account spend-money receipts post against, plus the expense
  // account code to book them to (defaults to XERO_EXPENSE_ACCOUNT_CODE / 400).
  xeroBankAccountId     String?
  xeroBankAccountName   String?
  xeroExpenseAccountCode String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("Account")
}

// A staff member who signs in. Roles gate what they can see/do (see
// src/lib/roles.ts + src/lib/permissions.ts). `role` is a String because SQLite
// has no native enum. `credentialEpoch` is bumped on password reset/deactivate
// to invalidate that user's existing session cookies without touching others.
model User {
  id              String   @id @default(cuid())
  name            String
  email           String   @unique
  passwordHash    String?  // null until the user sets a password (invite/reset flow)
  role            String   @default("OFFICE") // ADMIN | OFFICE | DESIGNER | FACTORY | INSTALLER
  active          Boolean  @default(true)
  credentialEpoch Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([email])
}

// A pending invitation to join the team. The email carries a single-use link
// whose token is stored only as a hash; accepting it sets the user's password.
model Invite {
  id        String    @id @default(cuid())
  email     String
  role      String    @default("OFFICE")
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
}

model Client {
  id            String    @id @default(cuid())
  name          String
  email         String?
  phone         String?
  address       String?
  notes         String?
  xeroContactId String?   @unique // linked Xero contact (set on first invoice push)
  jobs          Job[]
  invoices      Invoice[]
  portalTokens  ClientPortalToken[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// A single-purpose magic-link token for client-portal sign-in. The raw token
// travels in the emailed link; only its hash is stored. Verifying it sets a
// separate portal session cookie (see src/lib/portal-session.ts) scoped to this
// one client's jobs.
model ClientPortalToken {
  id         String    @id @default(cuid())
  clientId   String
  client     Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([clientId])
}

// A remembered person — name/email/phone captured whenever the owner enters
// one, so they can be suggested when filling out later jobs/invoices.
model Contact {
  id        String   @id @default(cuid())
  name      String?
  email     String?  @unique
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// An installer on the Harrington Kitchens team. Jobs are assigned to an
// installer; the installer portal shows their run sheet and lets them file
// maintenance reports against their jobs.
model Installer {
  id        String   @id @default(cuid())
  name      String
  role      String   @default("Installer") // e.g. Lead installer / Apprentice
  email     String?  @unique
  phone     String?
  color     String   @default("#0d9488") // chip / calendar colour
  active    Boolean  @default(true)
  notes     String?
  jobs      Job[]
  reports   MaintenanceReport[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A configurable factory station (P7). Company-wide, ordered by position.
model Station {
  id          String       @id @default(cuid())
  name        String
  position    Int          @default(0)
  hoursPerDay Float        @default(8)
  active      Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  jobStations JobStation[]

  @@index([position])
}

// A job's progress at one station (created when the job enters PRODUCTION).
model JobStation {
  id          String    @id @default(cuid())
  jobId       String
  job         Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  stationId   String
  station     Station   @relation(fields: [stationId], references: [id], onDelete: Cascade)
  position    Int       @default(0) // snapshot of the station order at creation
  status      String    @default("pending") // pending | in_progress | done
  checklist   String    @default("[]") // JSON [{ label, done }]
  notes       String?
  blocked     Boolean   @default(false)
  blockerNote String?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([jobId, stationId])
  @@index([jobId])
}

// Design drawings for a job (P6). A set groups its revisions (Rev A, B, …);
// each revision's files are Documents. Approved/released revisions are immutable
// — a change needs a new revision.
model DrawingSet {
  id        String            @id @default(cuid())
  jobId     String
  job       Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  revisions DrawingRevision[]

  @@index([jobId])
}

model DrawingRevision {
  id            String     @id @default(cuid())
  drawingSetId  String
  drawingSet    DrawingSet @relation(fields: [drawingSetId], references: [id], onDelete: Cascade)
  label         String     // e.g. "Rev A"
  status        String     @default("draft") // draft | sent | approved | released
  summary       String?    // AI change summary (internal) — P6.2
  summaryClient String?    // client-safe rewrite — P6.2
  notes         String?
  sentAt        DateTime?
  approvedAt    DateTime?
  releasedAt    DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  documents     Document[]
  comments      DrawingComment[]

  @@index([drawingSetId])
}

// A comment on a drawing revision — the client's review thread with the office.
model DrawingComment {
  id         String          @id @default(cuid())
  revisionId String
  revision   DrawingRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  authorType String          // client | staff
  authorName String
  body       String
  createdAt  DateTime        @default(now())

  @@index([revisionId])
}

// A scope variation on a job (P5.4 drafts them from check-measure discrepancies;
// pricing + portal approval land in P6.4). Amount is ex-GST integer cents.
model Variation {
  id          String   @id @default(cuid())
  jobId       String
  job         Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  title       String
  description String?
  amountCents Int      @default(0)
  status      String   @default("draft") // draft | sent | approved | declined
  source      String   @default("check_measure")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([jobId])
}

// The check-measure record for a job (P5): structured rooms/dimensions captured
// on site. One per job; the capture form (P5.2) fills `data`, and completing it
// (P5.4) diffs against the quote and moves the job to DESIGN.
model CheckMeasure {
  id          String    @id @default(cuid())
  jobId       String    @unique
  job         Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  data        String    @default("{}") // JSON { rooms: Room[] } — see lib/measure.ts
  status      String    @default("draft") // draft | complete
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// A visit to site by a staff member — a sales consultation (P4.4) or a check
// measure (P5). Assignee is a staff User (denormalised name for display).
model SiteVisit {
  id             String    @id @default(cuid())
  jobId          String
  job            Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  type           String    @default("CONSULT") // CONSULT | CHECK_MEASURE
  assigneeId     String?
  assigneeName   String?
  scheduledStart DateTime
  scheduledEnd   DateTime?
  notes          String?
  status         String    @default("scheduled") // scheduled | done | cancelled
  googleEventId  String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([jobId])
}

// A client's decision on a quote (P4.3) or, later, a design revision (P6). The
// signature is a typed name captured with a timestamp and IP for the record.
model Approval {
  id         String   @id @default(cuid())
  jobId      String
  job        Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  quoteId    String?  // the quote this decision was made on
  kind       String   @default("quote") // quote | design
  decision   String   // accepted | changes_requested
  signerName String?  // typed-name signature
  comment    String?  // the client's note when requesting changes
  ip         String?
  createdAt  DateTime @default(now())
}

// A versioned quote for a job (P4.2). Each edit-and-send makes a new version;
// the latest is the live one. Line amounts live in `sections` (dollars, ex GST,
// same shape as invoice lines); the totals are stored in integer cents so the
// figure the client accepts is exact and feeds the deposit invoice unchanged.
model Quote {
  id            String   @id @default(cuid())
  jobId         String
  job           Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  version       Int
  status        String   @default("draft") // draft | sent | accepted | declined | superseded
  currency      String   @default("AUD")
  sections      String   @default("[]")    // JSON QuoteSection[] (see lib/quote.ts)
  marginPct     Float    @default(0)
  notes         String?
  subtotalCents Int      @default(0)        // lines + margin, ex GST
  taxCents      Int      @default(0)        // GST
  totalCents    Int      @default(0)        // grand total, inc GST
  acceptedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([jobId, version])
}

// Job lifecycle: lead -> quoted -> accepted -> scheduled -> in_progress -> completed
//                                         \-> cancelled (from any state)
// Superseded by `pipelineStage` (see lib/pipeline.ts) — the full ENQUIRY..MAINTENANCE
// spine. `status` is mirrored from it (P3.1) until the pipeline UI retires it (P3.3).
model Job {
  id           String    @id @default(cuid())
  reference    String    @unique          // human reference e.g. JOB-1042
  title        String
  description  String?
  status       String    @default("lead") // see lifecycle above
  pipelineStage String   @default("ENQUIRY") // lib/pipeline.ts; mirrored with status
  priority     String    @default("normal") // low | normal | high

  // Scheduling
  scheduledStart DateTime?
  scheduledEnd   DateTime?
  durationMins   Int       @default(120)

  // Money
  quoteAmount  Float?
  currency     String   @default("AUD")

  // Per-job checklists (JSON arrays of { label, done }).
  // todos: work steps, drafted from the description by AI then edited.
  // maintenanceTasks: the return-trip / follow-up maintenance checklist.
  todos            String @default("[]")
  maintenanceTasks String @default("[]")

  // Component estimate built from the price list (JSON LineItem[]). Feeds the
  // job's quoteAmount ("Set as quote") and the invoice's default lines.
  estimateItems    String @default("[]")

  // Site
  address      String?

  // The client company this job belongs to (LeadSource.id) — the builder
  // company Harrington Kitchens installs for. Null = direct/private work.
  companyId    String?

  // Client link (the company's Client row once invoiced) + denormalised site
  // contact from the job sheet (homeowner name/phone; sender email for scans).
  clientId     String?
  client       Client?  @relation(fields: [clientId], references: [id])
  clientName   String?
  clientEmail  String?
  clientPhone  String?

  // The installer this job is assigned to. SetNull: removing an installer
  // leaves their jobs unassigned rather than deleting them.
  installerId  String?
  installer    Installer? @relation(fields: [installerId], references: [id], onDelete: SetNull)

  // Lead provenance — set when a job was imported from an incoming email.
  leadSource     String?  // sender email address it came from
  gmailMessageId String?  // source email (shared by all jobs split from one email)
  gmailThreadId  String?

  // Review flag set by intake reconciliation (e.g. "review" = the job's company
  // sent a weekly email that no longer lists it — possibly moved/cancelled).
  flag           String?

  // Google links
  googleEventId  String?  // primary calendar event (first working day)
  googleEventIds String?  // JSON array of all calendar event ids (one per working day)
  driveFolderId  String?  // Drive folder for this job's PDFs
  drivePhotosFolderId String? // shared "Photos (client)" subfolder (anyone-with-link)

  documents    Document[]
  tradeVisits  TradeVisit[]
  reports      MaintenanceReport[]
  activities   Activity[]
  invoices     Invoice[]
  quotes       Quote[]
  approvals    Approval[]
  siteVisits   SiteVisit[]
  checkMeasure CheckMeasure?
  variations   Variation[]
  drawingSets  DrawingSet[]
  jobStations  JobStation[]
  expenses     Expense[]

  notes        String?
  completedAt  DateTime? // set when status first becomes "completed" (real completion time)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// An invoice raised for a job, mirrored to Xero once pushed.
// Lifecycle: draft -> submitted -> authorised -> paid | voided.
// "Overdue" is derived (authorised, amountDue > 0, dueDate past) — never stored.
// jobId/clientId use SetNull: invoices are financial records and must survive
// a job being hard-deleted.
model Invoice {
  id            String    @id @default(cuid())
  number        String    @unique // local numbering e.g. INV-1001
  status        String    @default("draft")
  jobId         String?
  job           Job?      @relation(fields: [jobId], references: [id], onDelete: SetNull)
  clientId      String?
  client        Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  issueDate     DateTime  @default(now())
  dueDate       DateTime?
  currency      String    @default("AUD")
  // JSON array: [{ description, quantity, unitAmount, accountCode?, taxType? }]
  lineItems     String    @default("[]")
  subtotal      Float     @default(0)
  tax           Float     @default(0)
  total         Float     @default(0)
  amountPaid    Float     @default(0)
  amountDue     Float     @default(0)
  reference     String?   // shown on the Xero invoice (usually the job reference)
  // Xero mirror — null until pushed.
  xeroInvoiceId String?   @unique
  xeroContactId String?
  xeroNumber    String?   // Xero may renumber when org auto-numbering is on
  lastSyncedAt  DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// A business expense captured from a receipt photo. Vision extracts the vendor/
// date/amount/GST; optionally pushed to Xero as a spend-money BankTransaction
// (with the receipt image attached) so it's a one-tap reconcile against the bank
// feed. total is GST-inclusive; gst is the 1B credit; net = total - gst.
model Expense {
  id            String    @id @default(cuid())
  vendor        String?
  description   String?
  category      String?   // free-form, e.g. Materials / Fuel / Tools
  date          DateTime  @default(now())
  currency      String    @default("AUD")
  total         Float     @default(0) // GST-inclusive amount paid
  gst           Float     @default(0) // GST portion (BAS 1B)
  net           Float     @default(0) // total - gst
  hasGst        Boolean   @default(true)
  status        String    @default("captured") // captured | pushed
  jobId         String?
  job           Job?      @relation(fields: [jobId], references: [id], onDelete: SetNull)
  // Receipt image, stored inline (downscaled client-side before upload).
  receiptData   String?   // base64, no data: prefix
  receiptMime   String?   // e.g. image/jpeg
  // Xero mirror — null until pushed.
  xeroBankTransactionId String? @unique
  xeroContactId String?
  pushedAt      DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([date])
}

// A PDF (or other file) saved from email into Google Drive, linked to a job.
model Document {
  id          String   @id @default(cuid())
  jobId       String
  job         Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  name        String
  driveFileId String?
  webViewLink String?
  source      String   @default("gmail") // gmail | upload | report
  mimeType    String   @default("application/pdf")
  // Inline file bytes (base64) for plans uploaded through the dashboard, so
  // the client portal can serve them without Google Drive.
  fileData    String?
  // Plan review: share a plan to the client's portal and track their response.
  sharedWithClient Boolean  @default(false)
  reviewStatus     String?  // pending | approved | changes_requested
  reviewNote       String?  // the client's comment when requesting changes
  reviewedAt       DateTime?
  // A drawing revision this file belongs to (P6), when it's a design drawing.
  drawingRevisionId String?
  drawingRevision   DrawingRevision? @relation(fields: [drawingRevisionId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([drawingRevisionId])
}

// A trade visit booked against a job's site (plumber, electrician, stone
// templater…). Shown to the client on their portal and to the installer.
model TradeVisit {
  id             String    @id @default(cuid())
  jobId          String
  job            Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  trade          String    // e.g. Plumber
  company        String?   // e.g. Camden Plumbing Co
  scheduledStart DateTime
  scheduledEnd   DateTime?
  notes          String?
  status         String    @default("scheduled") // scheduled | done | cancelled
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model MaintenanceReport {
  id          String   @id @default(cuid())
  jobId       String
  job         Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  status      String   @default("draft") // draft | sent
  // Who filed it — set when a report comes in via the installer portal.
  installerId String?
  installer   Installer? @relation(fields: [installerId], references: [id], onDelete: SetNull)
  // Free-form report fields stored as JSON (engineer, findings, actions, recommendations, etc.)
  data        String   @default("{}")
  pdfPath     String?
  driveFileId String?
  webViewLink String?
  sentAt      DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Audit trail surfaced in the UI: what automations ran for a job.
model Activity {
  id        String   @id @default(cuid())
  jobId     String?
  job       Job?     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  type      String   // status_change | calendar | drive | email | report | note | invoice | expense | xero
  message   String
  meta      String   @default("{}")
  createdAt DateTime @default(now())
}

// Record of every lead email we've already scanned (even if it produced no
// jobs), so non-job emails aren't reprocessed (and re-charged) every scan.
model ProcessedEmail {
  id          String   @id @default(cuid())
  messageId   String   @unique
  jobsCreated Int      @default(0)
  reason      String?  // e.g. "maintenance", "no_new_jobs"
  createdAt   DateTime @default(now())
}

// Trusted senders whose emails are turned into job leads to approve. These are
// the client companies the owner works for (email holds their domain).
model LeadSource {
  id          String   @id @default(cuid())
  name        String
  displayName String?  // pretty client label, e.g. "Bellbrook Homes"
  email       String   @unique
  enabled     Boolean  @default(true)
  templates   String?  // JSON: per-company email overrides keyed by accepted|moved|cancelled
  createdAt   DateTime @default(now())
}

// Rate card: the install components the owner charges for. Each item has a
// default price plus optional per-company overrides (JSON keyed by
// LeadSource.id — same JSON-string precedent as LeadSource.templates).
model PriceItem {
  id            String   @id @default(cuid())
  name          String            // e.g. "Base cabinet install"
  unit          String   @default("each") // each | hour | metre
  price         Float    @default(0)      // default rate (ex GST)
  category      String?           // optional grouping, e.g. Kitchen
  companyPrices String   @default("{}")   // JSON { [leadSourceId]: price }
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// Web Push subscriptions (one per device that opted in to notifications).
model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

// A stock line in the factory hardware store (hinges, runners, screws…).
// Each line gets a printable QR label; scanning it with a phone opens the
// item's action page to log a delivery or flag it for reordering.
model HardwareItem {
  id           String   @id @default(cuid())
  code         String   @unique // short label code in the QR, e.g. HW-1007
  name         String
  category     String?  // Hinges / Runners / Fixings / Sealants…
  supplier     String?
  unit         String   @default("box") // box | pack | each | roll | tube
  packSize     String?  // e.g. "100 pcs" — printed on the label
  qtyOnHand    Int      @default(0)
  reorderLevel Int      @default(1) // at/below this the list suggests reordering
  location     String?  // shelf / bay in the factory
  notes        String?
  // Ordering loop: ok -> needs_order (scan when empty) -> on_order (office
  // marks ordered) -> ok again when the delivery is scanned in.
  orderStatus  String   @default("ok")
  orderQty     Int?     // how many to order when flagged
  orderNote    String?
  flaggedAt    DateTime?
  orderedAt    DateTime?
  events       HardwareEvent[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Audit trail per hardware line: deliveries in, reorder flags, orders placed.
model HardwareEvent {
  id        String       @id @default(cuid())
  itemId    String
  item      HardwareItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  type      String       // delivered | flagged | ordered | adjusted
  qty       Int?
  note      String?
  createdAt DateTime     @default(now())
}

// Editable templates for the automated client emails.
model EmailTemplate {
  id        String   @id @default(cuid())
  key       String   @unique // accepted | cancelled | moved | report
  subject   String
  body      String
  enabled   Boolean  @default(true)
  updatedAt DateTime @updatedAt
}
