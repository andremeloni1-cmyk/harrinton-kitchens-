# ---- Benchline configuration ----
# Copy to .env and fill in. .env is git-ignored. Benchline is the platform's
# working name; set APP_NAME (below) to white-label a deployment.

# SQLite database file (relative paths are resolved from the prisma/ dir).
DATABASE_URL="file:./harringtonkitchens.db"

# Public base URL of the app (used to build the Google OAuth redirect URI).
# Local dev: http://localhost:3000   Production: https://jobs.yourdomain.com
APP_URL="http://localhost:3000"

# White-label platform name (PWA / home-screen / browser title, system push,
# document metadata). The in-app header, portals and PDFs prefer your business
# Name + logo from Settings; this is the fallback. Blank defaults to "Benchline".
# Set both to your business name to white-label a deployment (e.g. "Harrington Kitchens").
APP_NAME=""
# Same value, exposed to the browser bundle so client-rendered chrome (nav
# wordmark before the company name loads, etc.) matches. Keep it equal to APP_NAME.
NEXT_PUBLIC_APP_NAME=""

# The owner's email — the single user who logs in / owns all jobs.
OWNER_EMAIL="you@example.com"

# ---- Google OAuth ----
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorised redirect URI must be: ${APP_URL}/api/auth/google/callback
# Enable these APIs: Google Calendar, Google Drive, Gmail.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---- Xero OAuth ----
# Create an app at https://developer.xero.com/app/manage (Web app, auth code flow).
# The redirect URI must be exactly: ${APP_URL}/api/auth/xero/callback
# Then connect from Settings. See deploy/XERO_SETUP.md for a walkthrough.
XERO_CLIENT_ID=""
XERO_CLIENT_SECRET=""
# Sales account code used on invoice line items (your Xero chart of accounts;
# "200" is the default Sales account). Drafts push without it, but authorising
# an invoice requires a valid account code.
XERO_SALES_ACCOUNT_CODE="200"
# Expense account code that captured receipts post to as spend-money
# (your Xero chart of accounts; overridable per-account in Settings → Xero).
XERO_EXPENSE_ACCOUNT_CODE="400"

# ---- Google Maps (optional) ----
# Enables address autocomplete on the job form. In Google Cloud Console
# (same project as the OAuth client is fine): enable "Places API (New)",
# create an API key under Credentials, and restrict it to Places API (New).
# Leave blank to keep the address field as a plain input.
GOOGLE_MAPS_API_KEY=""
# Country to bias/limit address suggestions to (ISO 3166-1 alpha-2).
ADDRESS_COUNTRY="au"

# Optional: a simple shared password to gate the dashboard (single-user app).
# Leave blank to disable the login gate (fine behind a private URL / VPN).
APP_PASSWORD=""

# Secret used to sign the session cookie. Generate with: openssl rand -hex 32
SESSION_SECRET="change-me-to-a-long-random-string"

# Shared secret for the automated inbox scan (cron). Generate with: openssl rand -hex 32
# Used by deploy/setup-cron.sh to let the scheduled task import new job leads.
CRON_SECRET=""

# ---- AI image reading (Anthropic Claude vision) ----
# Reads PNG/JPG job sheets from incoming emails and extracts the job details.
# Get a key at https://console.anthropic.com/ . Leave blank to disable (images
# are still saved to Drive, just not auto-read). ~1-3 cents per image.
ANTHROPIC_API_KEY=""
# Optional model override (defaults to the recommended claude-opus-4-8).
ANTHROPIC_MODEL=""

# ---- Push notifications (optional) ----
# Pings your phone when the inbox check finds new jobs to confirm / flags one.
# Generate a key pair once with:  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Contact URI for the push service (any mailto: you control).
VAPID_SUBJECT="mailto:you@example.com"

# ---- Scheduling / timezone ----
# Business timezone for calendar events. Jobs run 6:30am–3:00pm in this zone;
# multi-day jobs spill onto the following working days (weekends skipped).
BUSINESS_TZ="Australia/Sydney"
# Also set the process timezone so stored times line up with the business zone.
TZ="Australia/Sydney"
