# ---- Harrington Kitchens — first deployment config ----
# Copy to app/.env and fill the secrets. This is the Benchline platform,
# white-labelled as "Harrington Kitchens" (the company brand — name, logo and
# accent — is also set in Settings / the setup wizard).

DATABASE_URL="file:./harringtonkitchens.db"
APP_URL="https://jobs.harringtonkitchens.com.au"   # <- their real domain

# White-label the platform chrome to Harrington Kitchens.
APP_NAME="Harrington Kitchens"
NEXT_PUBLIC_APP_NAME="Harrington Kitchens"

# First admin (bootstrapped on deploy; change the password after first sign-in).
OWNER_EMAIL="office@harringtonkitchens.com.au"
OWNER_PASSWORD=""            # leave blank to auto-generate during install

# REQUIRED in production — generate with: openssl rand -hex 32
SESSION_SECRET=""
CRON_SECRET=""

# ---- Integrations (all optional; connect from the setup wizard / Settings) ----
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
XERO_CLIENT_ID=""
XERO_CLIENT_SECRET=""
XERO_SALES_ACCOUNT_CODE="200"
XERO_EXPENSE_ACCOUNT_CODE="400"
ANTHROPIC_API_KEY=""

# Address autocomplete (optional)
GOOGLE_MAPS_API_KEY=""
ADDRESS_COUNTRY="au"

# Phone push notifications (optional) — install.sh generates these for you.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""

# Australian business timezone for calendar events.
BUSINESS_TZ="Australia/Sydney"
